# development | production (default). Docs/OpenAPI only exposed in development.
ENVIRONMENT=production
UMAMI_URL=https://umami.example.com
UMAMI_USERNAME=admin
UMAMI_PASSWORD=change-me
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Token for POST /reports/weekly (header X-Trigger-Token). Empty = endpoint disabled.
TRIGGER_TOKEN=
# 0=Monday ... 6=Sunday
REPORT_WEEKDAY=0
REPORT_HOUR=9
TIMEZONE=America/Sao_Paulo
TOP_N=5
