# Every variable is listed so values from a developer's real .env never leak into tests.
ENVIRONMENT=production
UMAMI_URL=http://umami
UMAMI_USERNAME=user
UMAMI_PASSWORD=password
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1/token
TRIGGER_TOKEN=
REPORT_WEEKDAY=0
REPORT_HOUR=9
TIMEZONE=America/Sao_Paulo
TOP_N=5
